---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHomepage?: boolean;
  type?: "website" | "article";
  publishedAt?: Date;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image,
  isHomepage = false,
  type = "website",
  publishedAt,
  jsonLd,
} = Astro.props;

import global from "../data/global.json";
const siteName = global.siteName;
const pageTitle = title ? `${title} | ${siteName}` : siteName;

// Cloudflare serves pages with a trailing slash (e.g. /blog/)
const canonicalUrl = new URL(`${Astro.url.pathname.replace(/\/$/, "")}/`, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://api.fontshare.com/v2/css?f[]=switzer@1,2&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content={siteName} />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="author" content={siteName} />
    {
      publishedAt && (
        <meta property="article:published_time" content={publishedAt.toISOString()} />
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href="/rss.xml"
    />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ "@context": "https://schema.org", ...jsonLd })}
        />
      )
    }
    <script is:inline>
      // Unregister old service workers from previous Gatsby version
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          for (const registration of registrations) {
            registration.unregister();
          }
        });
      }
    </script>
  </head>
  <body
    style="font-family: 'Switzer', sans-serif;"
    class="flex flex-col min-h-screen text-gray-800 dark:text-gray-100"
  >
    <div class="flex-1 flex flex-col dark:bg-gray-900">
      {!isHomepage && <Navbar />}
      <main class="flex-1 bg-white dark:bg-gray-900">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
