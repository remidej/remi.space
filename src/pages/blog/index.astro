---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticlePreview from "../../components/ArticlePreview.astro";
import global from "../../data/global.json";
import {
  getPublishedBlogPosts,
  sortBlogPostsByDateDesc,
} from "../../utils/blog";
import { getPostUrl } from "../../utils/markdown";
import { BLOG_ID, PERSON_ID, person, website } from "../../utils/structured-data";

const posts = sortBlogPostsByDateDesc(await getPublishedBlogPosts());
---

<BaseLayout
  title="All articles"
  description={`View all the blog posts from ${global.siteName}`}
  jsonLd={{
    "@graph": [
      website,
      person,
      {
        "@type": "Blog",
        "@id": BLOG_ID,
        url: "https://remi.space/blog/",
        name: `${global.siteName}'s blog`,
        description:
          "Articles about making products for the web, using technologies like TypeScript and AI.",
        inLanguage: "en",
        author: { "@id": PERSON_ID },
        publisher: { "@id": PERSON_ID },
        isPartOf: { "@id": website["@id"] },
        blogPost: posts.map((post) => ({
          "@type": "BlogPosting",
          "@id": `${getPostUrl(post)}#article`,
          url: getPostUrl(post),
          headline: post.data.title,
          description: post.data.description,
          datePublished: post.data.date.toISOString(),
          author: { "@id": PERSON_ID },
        })),
      },
    ],
  }}
>
  <div class="container py-8">
    <h1
      class="uppercase tracking-wide text-blog-500 font-bold mb-6 text-lg"
    >
      All blog posts
    </h1>
    <section class="flex-1 flex flex-col gap-8">
      {
        posts.map((post) => (
          <ArticlePreview
            title={post.data.title}
            slug={post.data.slug}
            description={post.data.description}
          />
        ))
      }
    </section>
  </div>
</BaseLayout>
